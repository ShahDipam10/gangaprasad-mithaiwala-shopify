{%- style -%}
  #HeroShowcase-{{ section.id }} {
    position: relative;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  #HeroShowcase-{{ section.id }} .hero-slide {
    display: block !important;
    position: absolute;
    inset: 0;
    background-color: rgb(var(--color-background));
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  #HeroShowcase-{{ section.id }} .hero-slide.is-active {
    opacity: 1;
  }
  #HeroShowcase-{{ section.id }} .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(42,27,20,0.15) 0%, rgba(42,27,20,0.88) 100%);
  }
  #HeroShowcase-{{ section.id }} .hero-content {
    position: relative;
    z-index: 1;
    padding: 40px 20px 30px;
    max-width: 640px;
  }
  #HeroShowcase-{{ section.id }} .hero-content-inner {
    display: none;
  }
  #HeroShowcase-{{ section.id }} .hero-content-inner.is-active {
    display: block;
    animation: hero-fade-up 0.6s ease;
  }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #HeroShowcase-{{ section.id }} .hero-eyebrow {
    font-family: var(--font-body-family);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 10px;
  }
  #HeroShowcase-{{ section.id }} .hero-heading {
    font-size: 2.6rem;
    line-height: 1.1;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  #HeroShowcase-{{ section.id }} .hero-sub {
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 22px;
    max-width: 46ch;
  }
  #HeroShowcase-{{ section.id }} .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  #HeroShowcase-{{ section.id }} .hero-dots {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 7px;
    padding-bottom: 18px;
  }
  #HeroShowcase-{{ section.id }} .hero-dot {
    cursor: pointer;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    border: none;
    padding: 0;
    background: rgba(243,231,210,0.5);
  }
  #HeroShowcase-{{ section.id }} .hero-dot.is-active {
    width: 22px;
    background: rgb(var(--color-button));
  }
  #HeroShowcase-{{ section.id }} .hero-arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(42,27,20,0.35);
    color: #fbf4e8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  #HeroShowcase-{{ section.id }} .hero-arrow:hover {
    background: rgba(42,27,20,0.6);
  }
  #HeroShowcase-{{ section.id }} .hero-arrow svg {
    width: 18px;
    height: 18px;
  }
  #HeroShowcase-{{ section.id }} .hero-arrow--prev { left: 12px; }
  #HeroShowcase-{{ section.id }} .hero-arrow--next { right: 12px; }
  @media screen and (max-width: 749px) {
    #HeroShowcase-{{ section.id }} .hero-arrow { display: none; }
  }
  @media screen and (min-width: 750px) {
    #HeroShowcase-{{ section.id }} { min-height: 480px; }
    #HeroShowcase-{{ section.id }} .hero-heading { font-size: 4.2rem; }
    #HeroShowcase-{{ section.id }} .hero-content { padding: 0 20px 40px 48px; }
    #HeroShowcase-{{ section.id }} .hero-arrow { width: 48px; height: 48px; }
  }
{%- endstyle -%}

<hero-showcase id="HeroShowcase-{{ section.id }}" class="color-{{ section.settings.color_scheme }}" data-interval="{{ section.settings.change_slides_speed | times: 1000 }}">
  {%- for block in section.blocks -%}
    <div class="hero-slide{% if forloop.first %} is-active{% endif %}"{% if block.settings.image %} style="background-image:url('{{ block.settings.image | image_url: width: 1600 }}');"{% endif %} {{ block.shopify_attributes }}></div>
  {%- endfor -%}
  <div class="hero-scrim"></div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="hero-arrow hero-arrow--prev" aria-label="{{ 'sections.slideshow.previous_slide' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button type="button" class="hero-arrow hero-arrow--next" aria-label="{{ 'sections.slideshow.next_slide' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  {%- endif -%}

  <div class="hero-content">
    {%- for block in section.blocks -%}
      {%- liquid
        assign slide_eyebrow = block.settings.eyebrow | default: section.settings.eyebrow
        assign slide_heading = block.settings.heading | default: section.settings.heading
        assign slide_subheading = block.settings.subheading | default: section.settings.subheading
        assign slide_button_label = block.settings.button_label | default: section.settings.button_label
        assign slide_button_link = block.settings.button_link | default: section.settings.button_link
      -%}
      <div class="hero-content-inner{% if forloop.first %} is-active{% endif %}" data-hero-content>
        {%- if slide_eyebrow != blank -%}
          <div class="hero-eyebrow">{{ slide_eyebrow }}</div>
        {%- endif -%}
        {%- if slide_heading != blank -%}
          <h1 class="hero-heading">{{ slide_heading }}</h1>
        {%- endif -%}
        {%- if slide_subheading != blank -%}
          <p class="hero-sub">{{ slide_subheading }}</p>
        {%- endif -%}
        <div class="hero-actions">
          {%- if slide_button_label != blank -%}
            <a href="{{ slide_button_link }}" class="button">{{ slide_button_label }}</a>
          {%- endif -%}
          {%- if forloop.first and section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero-dot{% if forloop.first %} is-active{% endif %}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</hero-showcase>

<script>
  class HeroShowcase extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.hero-slide'));
      this.dots = Array.from(this.querySelectorAll('.hero-dot'));
      this.contents = Array.from(this.querySelectorAll('[data-hero-content]'));
      this.prevBtn = this.querySelector('.hero-arrow--prev');
      this.nextBtn = this.querySelector('.hero-arrow--next');
      this.index = 0;
      const interval = parseInt(this.dataset.interval, 10) || 4500;
      if (this.slides.length > 1) {
        this.timer = setInterval(() => this.go(this.index + 1), interval);
        this.dots.forEach((dot, i) => dot.addEventListener('click', () => { this.go(i); this.resetTimer(interval); }));
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => { this.go(this.index - 1); this.resetTimer(interval); });
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => { this.go(this.index + 1); this.resetTimer(interval); });
      }
    }
    go(i) {
      this.index = (i + this.slides.length) % this.slides.length;
      this.slides.forEach((s, idx) => s.classList.toggle('is-active', idx === this.index));
      this.dots.forEach((d, idx) => d.classList.toggle('is-active', idx === this.index));
      this.contents.forEach((c, idx) => c.classList.toggle('is-active', idx === this.index));
    }
    resetTimer(interval) {
      clearInterval(this.timer);
      this.timer = setInterval(() => this.go(this.index + 1), interval);
    }
    disconnectedCallback() {
      clearInterval(this.timer);
    }
  }
  customElements.define('hero-showcase', HeroShowcase);
</script>

{% schema %}
{
  "name": "Hero showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-3", "label": "Color scheme" },
    { "type": "text", "id": "eyebrow", "default": "Since 1919 · Anand, Gujarat", "label": "Default eyebrow" },
    { "type": "text", "id": "heading", "default": "Three generations of Anand's sweetest mornings", "label": "Default heading" },
    { "type": "textarea", "id": "subheading", "default": "Fresh cow's milk, small daily batches, no preservatives — mithai made the way Gangaprasad started it, a century ago.", "label": "Default subheading" },
    { "type": "text", "id": "button_label", "default": "Shop Sweets", "label": "Default button label" },
    { "type": "url", "id": "button_link", "label": "Default button link" },
    { "type": "text", "id": "button_label_2", "default": "Festival Specials", "label": "Secondary button label (slide 1 only)" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5, "label": "Change slides every" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "header", "content": "Overrides (optional)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero showcase",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
