{%- style -%}
  #InstagramFeed-{{ section.id }} .instagram-feed__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__heading {
    margin: 0;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__handle {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__handle svg {
    width: 18px;
    height: 18px;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    display: block;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__item:hover img {
    transform: scale(1.05);
  }
  #InstagramFeed-{{ section.id }} .instagram-feed__item-icon {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 18px;
    height: 18px;
    color: #fff;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));
  }
  @media screen and (min-width: 750px) {
    #InstagramFeed-{{ section.id }} .instagram-feed__grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
    }
  }
{%- endstyle -%}

<div id="InstagramFeed-{{ section.id }}" class="section color-{{ section.settings.color_scheme }} gradient" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="instagram-feed__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="instagram-feed__heading h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a href="{{ section.settings.profile_url | default: '#' }}" class="instagram-feed__handle link" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          {{ section.settings.handle }}
        </a>
      {%- endif -%}
    </div>
    <div class="instagram-feed__grid">
      {%- for block in section.blocks -%}
        <a href="{{ section.settings.profile_url | default: '#' }}" class="instagram-feed__item" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image_url != blank -%}
            <img src="{{ block.settings.image_url }}" alt="{{ block.settings.alt | default: 'Gangaprasad Mithaiwala on Instagram' }}" loading="lazy">
          {%- endif -%}
          <svg class="instagram-feed__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Color scheme" },
    { "type": "text", "id": "heading", "default": "From our kitchen to your feed", "label": "Heading" },
    { "type": "text", "id": "handle", "default": "@gangaprasadmithaiwala", "label": "Instagram handle" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
