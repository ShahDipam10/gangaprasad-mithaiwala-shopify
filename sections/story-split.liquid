{%- style -%}
  #StorySplit-{{ section.id }} .story-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: center;
  }
  #StorySplit-{{ section.id }} .story-media {
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
  }
  #StorySplit-{{ section.id }} .story-media img {
    width: 100%;
    display: block;
    object-fit: cover;
  }
  #StorySplit-{{ section.id }} .story-eyebrow {
    font-family: var(--font-body-family);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    opacity: 0.75;
    margin-bottom: 10px;
  }
  #StorySplit-{{ section.id }} .story-heading {
    margin: 0 0 14px;
  }
  #StorySplit-{{ section.id }} .story-body {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  #StorySplit-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #StorySplit-{{ section.id }} .story-inner {
      flex-direction: row{% if section.settings.image_position == 'right' %}-reverse{% endif %};
      gap: 56px;
    }
    #StorySplit-{{ section.id }} .story-media,
    #StorySplit-{{ section.id }} .story-text { flex: 1; }
    #StorySplit-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="StorySplit-{{ section.id }}" class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width story-inner">
    <div class="story-media">
      {%- if section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="story-text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="story-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- if request.page_type == 'page' -%}
          <h1 class="story-heading h1">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="story-heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="story-body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_label }} &rarr;</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story split",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Color scheme" },
    { "type": "text", "id": "image_url", "label": "Image URL" },
    { "type": "select", "id": "image_position", "default": "left", "label": "Image position", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "text", "id": "eyebrow", "default": "Our Story", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "Founded in 1919, in India's dairy capital", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body text" },
    { "type": "text", "id": "button_label", "default": "Read our full story", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "Padding bottom" }
  ],
  "presets": [{ "name": "Story split" }]
}
{% endschema %}
