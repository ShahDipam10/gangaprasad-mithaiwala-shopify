{%- style -%}
  #CategoryTiles-{{ section.id }} .category-tiles__heading {
    text-align: center;
    margin: 0 0 28px;
  }
  #CategoryTiles-{{ section.id }} .category-tiles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  #CategoryTiles-{{ section.id }} .category-tile {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4/3;
    text-decoration: none;
  }
  #CategoryTiles-{{ section.id }} .category-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  #CategoryTiles-{{ section.id }} .category-tile:hover img {
    transform: scale(1.06);
  }
  #CategoryTiles-{{ section.id }} .category-tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(42,27,20,0.82) 100%);
  }
  #CategoryTiles-{{ section.id }} .category-tile__body {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    color: #fbf4e8;
  }
  #CategoryTiles-{{ section.id }} .category-tile__label {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 4px;
  }
  #CategoryTiles-{{ section.id }} .category-tile__count {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    opacity: 0.85;
  }
  #CategoryTiles-{{ section.id }} .category-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 8px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  #CategoryTiles-{{ section.id }} .category-tile:hover .category-tile__cta {
    opacity: 1;
    transform: translateY(0);
  }
  @media screen and (min-width: 750px) {
    #CategoryTiles-{{ section.id }} .category-tiles__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
{%- endstyle -%}

<div id="CategoryTiles-{{ section.id }}" class="section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="category-tiles__heading h1">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="category-tiles__grid">
      {%- for block in section.blocks -%}
        {%- assign tile_collection = collections[block.settings.collection] -%}
        <a
          href="{{ tile_collection.url | default: '#' }}"
          class="category-tile"
          {{ block.shopify_attributes }}
        >
          {%- if tile_collection.image != blank -%}
            <img src="{{ tile_collection.image | image_url: width: 800 }}" alt="{{ tile_collection.title | escape }}" loading="lazy">
          {%- elsif block.settings.image_url != blank -%}
            <img src="{{ block.settings.image_url }}" alt="{{ tile_collection.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="category-tile__scrim"></div>
          <div class="category-tile__body">
            <div class="category-tile__label">{{ block.settings.label | default: tile_collection.title }}</div>
            {%- if tile_collection != blank -%}
              <div class="category-tile__count">{{ tile_collection.products_count }} items</div>
            {%- endif -%}
            <div class="category-tile__cta">Shop now &rarr;</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "text", "id": "heading", "default": "Shop by Category", "label": "Heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "text", "id": "image_url", "label": "Image URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
