{%- style -%}
  #OccasionShowcase-{{ section.id }} .occasion-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  #OccasionShowcase-{{ section.id }} .occasion-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4/5;
    display: block;
  }
  #OccasionShowcase-{{ section.id }} .occasion-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #OccasionShowcase-{{ section.id }} .occasion-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(42,27,20,0.88) 100%);
  }
  #OccasionShowcase-{{ section.id }} .occasion-text {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    color: #FBF4E8;
  }
  #OccasionShowcase-{{ section.id }} .occasion-label {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }
  #OccasionShowcase-{{ section.id }} .occasion-desc {
    font-family: var(--font-body-family);
    font-size: 11.5px;
    color: #F3E7D2;
    margin: 2px 0 0;
  }
  @media screen and (min-width: 750px) {
    #OccasionShowcase-{{ section.id }} .occasion-grid { grid-template-columns: repeat(4, 1fr); }
  }
{%- endstyle -%}

<div id="OccasionShowcase-{{ section.id }}" class="section color-{{ section.settings.color_scheme }}" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="margin: 0 0 18px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="occasion-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="occasion-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image_url != blank -%}
            <img src="{{ block.settings.image_url }}" alt="{{ block.settings.label }}" loading="lazy">
          {%- endif -%}
          <div class="occasion-scrim"></div>
          <div class="occasion-text">
            <p class="occasion-label">{{ block.settings.label }}</p>
            <p class="occasion-desc">{{ block.settings.description }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by occasion",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "text", "id": "heading", "default": "Shop by Occasion", "label": "Heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by occasion",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
