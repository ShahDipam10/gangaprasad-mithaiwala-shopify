{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "rating": {
          "type": "rating"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust_badges_product": {
          "type": "trust_badges_product"
        },
        "description": {
          "type": "description"
        },
        "ingredients_shelf_life": {
          "type": "ingredients_shelf_life"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "rating",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_badges_product",
        "description",
        "ingredients_shelf_life",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "reviews": {
      "type": "product-reviews",
      "settings": {
        "color_scheme": "scheme-2",
        "heading": "Customer Reviews",
        "padding_top": 40,
        "padding_bottom": 20
      },
      "blocks": {
        "r1": { "type": "review", "settings": { "stars": 5, "text": "Tastes exactly like what I remember from my grandmother's kitchen. Ordered for Diwali and it arrived fresh.", "name": "Priya S." } },
        "r2": { "type": "review", "settings": { "stars": 5, "text": "Best kaju katli I've had outside Anand. Not overly sweet, and the silver leaf is real.", "name": "Rakesh M." } },
        "r3": { "type": "review", "settings": { "stars": 4, "text": "Ordered a gift hamper for my in-laws — packaging was lovely and everyone loved it.", "name": "Anjali D." } }
      },
      "block_order": ["r1", "r2", "r3"]
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 20,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "reviews",
    "related-products"
  ]
}
